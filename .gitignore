# 依赖与构建产物
node_modules/
dist/
build/
.next/
out/
*.tsbuildinfo
web/.next/
web/out/
server/dist/

# 环境与密钥（绝不提交）
.env
.env.*
!.env.example
*.key
*.pem

# 从 node_modules 复制的 MapLibre worker（每次构建由 scripts/copy-maplibre-worker.mjs 重新生成）
web/public/maplibre-gl-worker.mjs

# 密钥密文与本地密钥材料（正常应位于 %LOCALAPPDATA%\cartouche，出现在仓库内即视为放错位置）
llm-key.txt
*.dpapi
secrets/
keys/

# 本地工具与日志
scripts/*.log
scripts/*.err.log
scripts/*.log.err
tools/
vendor/gdal/
.conda/

# 内部工作稿：只保留面向使用者的文档（README / NOTICE），
# 其余过程材料放在仓库外归档。
docs/

# 本地备份：改写 README 前的副本，不进仓库
README_副本.md

# AI 助手与设计技能的本地痕迹（工具产物，不进仓库）
.superpowers/
.claude/
.cursor/
.aider/
.cline/
.impeccable/
AGENTS.md
CLAUDE.md

# 界面截图（验收/交付用）。放在仓库根而不是 web/out/，
# 因为 `next build` 会**清空 web/out/**，放在那儿每次构建都被冲掉。
shots/

# 生成的样本与中间产物（可由 npm run fixture 重建）
fixtures/*.asc
fixtures/*.pnm
fixtures/*.tff
fixtures/*.tfw
fixtures/*.prj
fixtures/*.shp
fixtures/*.dbf
fixtures/*.shx
fixtures/*.gdb/
fixtures/roundtrip.*

# 公开真实数据样本（体积大、按需下载，不入库；清单与说明入库）
samples/*
!samples/manifest.json
!samples/README.md

# 工作区（用户实际操作的图件所在目录；由 scripts\seed-workspace.mjs 播种）
# 必须写成 /workspace/ 锚定到仓库根：
# 不带前导斜杠时这条规则会匹配**任意层级**的 workspace/ 目录，
# 把引擎核心目录 src/engine/workspace/ 一起吞掉 —— 那样仓库里就缺了引擎的
# workspace 适配器，clone 出来直接编译不过。
/workspace/

# 操作系统与编辑器
Thumbs.db
.DS_Store
.idea/
.vscode/
*.swp

# 发布包（npm run pack:release 的产物）：几十 MB 的 zip，不进仓库
release/

# 会话交接指针（本地文件）：真正的交接文档在仓库外 %LOCALAPPDATA% 之外的 .minimax\handoff\
HANDOFF.md

# 测试用的临时目录（gdal-env 用例建在仓库根之下，保证与仓库同盘）
/.tmp-test/
