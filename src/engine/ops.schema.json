{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cartouche.dev/schemas/operation-plan.v1.json",
  "title": "操作计划 (Operation Plan)",
  "description": "AI 提议、确定性引擎执行的唯一契约。LLM 的唯一合法产物是一份符合本 Schema 的计划；引擎逐条校验后执行，并强制输出量化影响报告。基准集见 bench/cases.json。",
  "type": "object",
  "required": ["version", "ops"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": "1.0" },
    "intent": {
      "type": "string",
      "maxLength": 500,
      "description": "用户原话或规整后的意图描述，用于审计与复现"
    },
    "ops": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": { "$ref": "#/$defs/operation" }
    }
  },
  "$defs": {
    "bbox": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "type": "number" },
      "description": "[minX, minY, maxX, maxY]，坐标系必须与目标图层一致"
    },
    "layerRef": {
      "type": "string",
      "pattern": "^(layer|dataset|summary)://.+",
      "description": "图层引用，如 layer://2024_basemap、dataset://current.tff。只用于不由引擎执行器落地的 op（dataset.* / feature.* / vector.* / export.*）；引擎要改文件时一律用 pathRef"
    },
    "pathRef": {
      "type": "string",
      "pattern": "^dataset://.+$",
      "description": "工作区相对路径引用，如 dataset://底图/current.tff。引擎只认这一种：layer:// 是图层标识、不是文件路径，引擎会拒掉（“目标引用不是文件路径”）；裸相对路径引擎能跑，但不符合契约"
    },
    "pixelRegion": {
      "type": "object",
      "required": ["minX", "minY", "maxX", "maxY"],
      "additionalProperties": false,
      "properties": {
        "minX": { "type": "number" },
        "minY": { "type": "number" },
        "maxX": { "type": "number" },
        "maxY": { "type": "number" }
      },
      "description": "像元坐标区域 { minX, minY, maxX, maxY }：左上角为原点（与 GDAL 行序一致），maxX/maxY 为不含；引擎按像元直接裁剪"
    },
    "region": {
      "description": "要改动的区域。两种形状二选一：①像元坐标对象 { minX, minY, maxX, maxY }；②地理范围数组 [minX, minY, maxX, maxY]（目标图层坐标系，引擎按仿射参数换算成像元）。不要写 layer:// / dataset:// 引用——引擎无法把图层引用解析成区域",
      "allOf": [
        {
          "if": { "type": "object" },
          "then": { "$ref": "#/$defs/pixelRegion" },
          "else": { "$ref": "#/$defs/bbox" }
        }
      ]
    },
    "pixelMask": {
      "type": "object",
      "required": ["width", "height", "data"],
      "additionalProperties": false,
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "data": { "type": "string", "description": "base64 编码的逐像元不透明度字节，长度 = width × height；0 = 不着色，255 = 完全着色" }
      },
      "description": "自由形状画笔掩膜；与矩形区域取交集。坐标**相对 region 左上角**：掩膜宽高 = region 包围盒的宽高，第 (0,0) 个字节对应 region 左上角那个像元。一般由画布栅格化产生，不手写"
    },
    "hexColor": {
      "type": "string",
      "pattern": "^(#[0-9a-fA-F]{6}|[0-9a-fA-F]{6}|sample-from-edge)$",
      "description": "'#RRGGBB'、'RRGGBB'，或 'sample-from-edge'（从区域外沿取色）"
    },
    "rgb": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "integer", "minimum": 0, "maximum": 255 },
      "description": "[r, g, b]（0~255 整数）。只收三通道：引擎的 parseColor 只取前三个，第 4 个 alpha 会被丢掉——写了也没用"
    },
    "operation": {
      "type": "object",
      "required": ["op", "params"],
      "additionalProperties": false,
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "dataset.open",
            "dataset.healthCheck",
            "dataset.snapshot",
            "raster.replaceRegion",
            "raster.erase",
            "raster.inpaint",
            "raster.clip",
            "raster.mosaic",
            "raster.resample",
            "raster.adjustLevels",
            "raster.paint",
            "feature.setAttributes",
            "feature.delete",
            "feature.editGeometry",
            "feature.create",
            "feature.summarize",
            "vector.repairGeometry",
            "vector.renameFields",
            "vector.recode",
            "vector.reproject",
            "vector.overlay",
            "vector.query",
            "vector.addField",
            "vector.spatialJoin",
            "export.image",
            "export.report"
          ]
        },
        "params": { "type": "object" },
        "preconditions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "crsEqual": { "type": "boolean" },
            "sourceExists": { "type": "boolean" },
            "resolutionCompatible": { "type": "boolean" },
            "maxAffectedPixels": { "type": "integer", "minimum": 0 },
            "maxAffectedFeatures": { "type": "integer", "minimum": 0 }
          }
        },
        "expect": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxDelta": { "type": "number", "minimum": 0 },
            "maxAffectedPixels": { "type": "integer", "minimum": 0 },
            "maxAffectedFeatures": { "type": "integer", "minimum": 0 }
          },
          "description": "执行前的预期上限；超出则中止并报告，不静默继续"
        },
        "requireUserConfirm": {
          "type": "boolean",
          "default": true,
          "description": "涉及删除、重命名、批量修改时必须为 true——这些操作不可逆，必须人工确认"
        }
      },
      "allOf": [
        { "if": { "properties": { "op": { "const": "dataset.open" } }, "required": ["op"] }, "then": { "properties": { "params": { "$ref": "#/$defs/params.dataset.open" } } } },
        { "if": { "properties": { "op": { "const": "dataset.healthCheck" } }, "required": ["op"] }, "then": { "properties": { "params": { "$ref": "#/$defs/params.dataset.healthCheck" } } } },
        { "if": { "properties": { "op": { "const": "dataset.snapshot" } }, "required": ["op"] }, "then": { "properties": { "params": { "$ref": "#/$defs/params.dataset.snapshot" } } } },
        { "if": { "properties": { "op": { "const": "raster.replaceRegion" } }, "required": ["op"] }, "then": { "properties": { "params": { "$ref": "#/$defs/params.raster.replaceRegion" } } } },
        { "if": { "properties": { "op": { "const": "raster.erase" } }, "required": ["op"] }, "then": { "properties": { "params": { "$ref": "#/$defs/params.raster.erase" } } } },
        { "if": { "properties": { "op": { "const": "raster.inpaint" } }, "required": ["op"] }, "then": { "properties": { "params": { "$ref": "#/$defs/params.raster.inpaint" } } } },
        { "if": { "properties": { "op": { "const": "raster.clip" } }, "required": ["op"] }, "then": { "properties": { "params": { "$ref": "#/$defs/params.raster.clip" } } } },
        { "if": { "properties": { "op": { "const": "raster.mosaic" } }, "required": ["op"] }, "then": { "properties": { "params": { "$ref": "#/$defs/params.raster.mosaic" } } } },
        { "if": { "properties": { "op": { "const": "raster.resample" } }, "required": ["op"] }, "then": { "properties": { "params": { "$ref": "#/$defs/params.raster.resample" } } } },
        { "if": { "properties": { "op": { "const": "raster.adjustLevels" } }, "required": ["op"] }, "then": { "properties": { "params": { "$ref": "#/$defs/params.raster.adjustLevels" } } } },
        { "if": { "properties": { "op": { "const": "raster.paint" } }, "required": ["op"] }, "then": { "properties": { "params": { "$ref": "#/$defs/params.raster.paint" } } } },
        { "if": { "properties": { "op": { "const": "feature.setAttributes" } }, "required": ["op"] }, "then": { "properties": { "params": { "$ref": "#/$defs/params.feature.setAttributes" } } } },
        { "if": { "properties": { "op": { "const": "feature.delete" } }, "required": ["op"] }, "then": { "properties": { "params": { "$ref": "#/$defs/params.feature.delete" } } } },
        { "if": { "properties": { "op": { "const": "feature.editGeometry" } }, "required": ["op"] }, "then": { "properties": { "params": { "$ref": "#/$defs/params.feature.editGeometry" } } } },
        { "if": { "properties": { "op": { "const": "feature.create" } }, "required": ["op"] }, "then": { "properties": { "params": { "$ref": "#/$defs/params.feature.create" } } } },
        { "if": { "properties": { "op": { "const": "feature.summarize" } }, "required": ["op"] }, "then": { "properties": { "params": { "$ref": "#/$defs/params.feature.summarize" } } } },
        { "if": { "properties": { "op": { "const": "vector.repairGeometry" } }, "required": ["op"] }, "then": { "properties": { "params": { "$ref": "#/$defs/params.vector.repairGeometry" } } } },
        { "if": { "properties": { "op": { "const": "vector.renameFields" } }, "required": ["op"] }, "then": { "properties": { "params": { "$ref": "#/$defs/params.vector.renameFields" } } } },
        { "if": { "properties": { "op": { "const": "vector.recode" } }, "required": ["op"] }, "then": { "properties": { "params": { "$ref": "#/$defs/params.vector.recode" } } } },
        { "if": { "properties": { "op": { "const": "vector.reproject" } }, "required": ["op"] }, "then": { "properties": { "params": { "$ref": "#/$defs/params.vector.reproject" } } } },
        { "if": { "properties": { "op": { "const": "vector.overlay" } }, "required": ["op"] }, "then": { "properties": { "params": { "$ref": "#/$defs/params.vector.overlay" } } } },
        { "if": { "properties": { "op": { "const": "vector.query" } }, "required": ["op"] }, "then": { "properties": { "params": { "$ref": "#/$defs/params.vector.query" } } } },
        { "if": { "properties": { "op": { "const": "vector.addField" } }, "required": ["op"] }, "then": { "properties": { "params": { "$ref": "#/$defs/params.vector.addField" } } } },
        { "if": { "properties": { "op": { "const": "vector.spatialJoin" } }, "required": ["op"] }, "then": { "properties": { "params": { "$ref": "#/$defs/params.vector.spatialJoin" } } } },
        { "if": { "properties": { "op": { "const": "export.image" } }, "required": ["op"] }, "then": { "properties": { "params": { "$ref": "#/$defs/params.export.image" } } } },
        { "if": { "properties": { "op": { "const": "export.report" } }, "required": ["op"] }, "then": { "properties": { "params": { "$ref": "#/$defs/params.export.report" } } } }
      ]
    },

    "params.dataset.open": {
      "type": "object",
      "required": ["targets"],
      "additionalProperties": false,
      "properties": {
        "targets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/layerRef" } },
        "purpose": { "type": "string", "maxLength": 200 }
      }
    },
    "params.dataset.healthCheck": {
      "type": "object",
      "required": ["target", "checks"],
      "additionalProperties": false,
      "properties": {
        "target": { "$ref": "#/$defs/layerRef" },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "crs-present", "crs-mismatch", "crs-range-sanity", "axis-order", "extent-plausibility",
              "systematic-offset", "encoding", "field-naming", "field-type", "default-fields",
              "null-geometry", "zero-area", "sharp-angle", "outlier-extent", "extent-compare"
            ]
          }
        },
        "angleThresholdDeg": { "type": "number", "exclusiveMinimum": 0, "maximum": 180 },
        "reference": { "$ref": "#/$defs/layerRef" },
        "encoding": { "type": "string", "enum": ["GBK", "UTF-8", "LATIN1", "auto"] }
      }
    },
    "params.dataset.snapshot": {
      "type": "object",
      "required": ["target"],
      "additionalProperties": false,
      "properties": {
        "target": { "$ref": "#/$defs/layerRef" },
        "label": { "type": "string", "maxLength": 100 },
        "includeSidecars": { "type": "boolean", "default": true, "description": "是否连同 .tfw/.prj/.cpg 等伴随文件一起快照" }
      }
    },
    "params.raster.replaceRegion": {
      "type": "object",
      "required": ["source", "target"],
      "additionalProperties": false,
      "properties": {
        "source": { "$ref": "#/$defs/pathRef" },
        "target": { "$ref": "#/$defs/pathRef" },
        "bbox": { "$ref": "#/$defs/bbox" },
        "region": {
          "$ref": "#/$defs/region",
          "description": "替换范围。两种形状二选一：①像元坐标对象 { minX, minY, maxX, maxY }；②地理范围数组 [minX, minY, maxX, maxY]（目标图层坐标系）。不要写 layer:// / dataset:// 引用"
        },
        "featherPx": { "type": "integer", "minimum": 0, "maximum": 200, "default": 0, "description": "边缘羽化宽度（像素）。0 = 硬边；给了就真的按羽化混合" }
      },
      "description": "source/target 必填；bbox 与 region 至少给一个"
    },
    "params.raster.erase": {
      "type": "object",
      "required": ["target", "region"],
      "additionalProperties": false,
      "properties": {
        "target": { "$ref": "#/$defs/pathRef" },
        "region": {
          "$ref": "#/$defs/region",
          "description": "要擦除的区域。两种形状二选一：①像元坐标对象 { minX, minY, maxX, maxY }；②地理范围数组 [minX, minY, maxX, maxY]（目标图层坐标系）。不要写 layer:// / dataset:// 引用"
        },
        "source": { "$ref": "#/$defs/pathRef", "description": "干净底图。给了就用底图像素替换该区域，不给则用边界内插近似修补" }
      }
    },
    "params.raster.inpaint": {
      "type": "object",
      "required": ["target", "region"],
      "additionalProperties": false,
      "properties": {
        "target": { "$ref": "#/$defs/pathRef" },
        "region": {
          "$ref": "#/$defs/region",
          "description": "要修补的区域。两种形状二选一：①像元坐标对象 { minX, minY, maxX, maxY }；②地理范围数组 [minX, minY, maxX, maxY]（目标图层坐标系）。不要写 layer:// / dataset:// 引用"
        },
        "radiusPx": { "type": "integer", "minimum": 1, "maximum": 100, "default": 4, "description": "边界内插半径（像素），缺省 4" }
      }
    },
    "params.raster.clip": {
      "type": "object",
      "required": ["target"],
      "additionalProperties": false,
      "properties": {
        "target": { "$ref": "#/$defs/pathRef" },
        "clip": { "$ref": "#/$defs/pathRef", "description": "矢量裁切范围（工作区相对路径）" },
        "bbox": { "$ref": "#/$defs/bbox", "description": "地理范围裁切（目标图层坐标系）" }
      },
      "anyOf": [{ "required": ["clip"] }, { "required": ["bbox"] }],
      "description": "target 必填；clip 与 bbox 至少给一个——都不给引擎会明确报错，不会空跑一遍"
    },
    "params.raster.mosaic": {
      "type": "object",
      "required": ["inputs"],
      "additionalProperties": false,
      "properties": {
        "inputs": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/pathRef" } },
        "output": { "$ref": "#/$defs/pathRef", "description": "输出路径；不给则用第一幅的名字加 -merged.tif" }
      }
    },
    "params.raster.resample": {
      "type": "object",
      "required": ["target", "targetResolution", "resampleMethod"],
      "additionalProperties": false,
      "properties": {
        "target": { "$ref": "#/$defs/pathRef" },
        "targetResolution": { "type": "number", "exclusiveMinimum": 0, "description": "目标像元大小（与源图同一单位）" },
        "resampleMethod": { "type": "string", "enum": ["nearest", "bilinear", "cubic", "average"] }
      },
      "description": "target / targetResolution / resampleMethod 必填：引擎按 -tr <分辨率> 重采样，改的是这一张图"
    },
    "params.raster.adjustLevels": {
      "type": "object",
      "required": ["target"],
      "additionalProperties": false,
      "properties": {
        "target": { "$ref": "#/$defs/pathRef" },
        "brightness": { "type": "number", "minimum": -1, "maximum": 1, "default": 0 },
        "contrast": { "type": "number", "minimum": 0, "maximum": 4, "default": 1 },
        "method": { "type": "string", "enum": ["linear-stretch", "gamma", "manual"], "default": "linear-stretch" },
        "gamma": { "type": "number", "exclusiveMinimum": 0, "default": 2.2, "description": "伽马值；method=gamma 时生效，缺省 2.2" }
      }
    },
    "params.raster.paint": {
      "type": "object",
      "required": ["target", "region", "color"],
      "additionalProperties": false,
      "properties": {
        "target": { "$ref": "#/$defs/pathRef" },
        "region": {
          "$ref": "#/$defs/region",
          "description": "要涂色的区域。两种形状二选一：①像元坐标对象 { minX, minY, maxX, maxY }；②地理范围数组 [minX, minY, maxX, maxY]（目标图层坐标系）。不要写 layer:// / dataset:// 引用"
        },
        "color": {
          "description": "涂色颜色：'#RRGGBB'、'sample-from-edge'（从区域外沿取色）或 [r, g, b]（只三通道）",
          "allOf": [
            { "if": { "type": "string" }, "then": { "$ref": "#/$defs/hexColor" }, "else": { "$ref": "#/$defs/rgb" } }
          ]
        },
        "mask": { "$ref": "#/$defs/pixelMask" }
      }
    },
    "params.feature.setAttributes": {
      "type": "object",
      "required": ["target", "where", "set"],
      "additionalProperties": false,
      "properties": {
        "target": { "$ref": "#/$defs/layerRef" },
        "where": { "type": "string", "description": "SQL where 子句，字段名必须来自目标图层 schema" },
        "set": { "type": "object", "description": "字段名 → 新值" }
      }
    },
    "params.feature.delete": {
      "type": "object",
      "required": ["target", "where"],
      "additionalProperties": false,
      "properties": {
        "target": { "$ref": "#/$defs/layerRef" },
        "where": { "type": "string" },
        "keep": { "type": "string", "enum": ["none", "first", "last", "largest"], "default": "none" }
      }
    },
    "params.feature.editGeometry": {
      "type": "object",
      "required": ["target", "selection", "geometry"],
      "additionalProperties": false,
      "properties": {
        "target": { "$ref": "#/$defs/layerRef" },
        "selection": {
          "type": "object",
          "required": ["where"],
          "additionalProperties": false,
          "properties": {
            "where": { "type": "string" },
            "limit": { "type": "integer", "minimum": 1, "maximum": 10000 }
          }
        },
        "geometry": {
          "type": "object",
          "required": ["type", "coordinates"],
          "additionalProperties": false,
          "properties": {
            "type": { "enum": ["Point", "LineString", "Polygon", "MultiPolygon"] },
            "coordinates": { "type": "array" }
          }
        },
        "transform": { "type": "string", "enum": ["none", "swap-lat-lon", "translate", "snap-to-target"], "default": "none" }
      }
    },
    "params.feature.create": {
      "type": "object",
      "required": ["target", "geometry"],
      "additionalProperties": false,
      "properties": {
        "target": { "$ref": "#/$defs/layerRef" },
        "geometry": {
          "type": "object",
          "required": ["type", "coordinates"],
          "additionalProperties": false,
          "properties": {
            "type": { "enum": ["Point", "LineString", "Polygon", "MultiPolygon"] },
            "coordinates": { "type": "array" }
          }
        },
        "attributes": { "type": "object" },
        "inheritFrom": { "type": "string", "enum": ["none", "nearest-neighbour", "template"], "default": "none" }
      }
    },
    "params.feature.summarize": {
      "type": "object",
      "required": ["target", "groupBy", "aggregates"],
      "additionalProperties": false,
      "properties": {
        "target": { "$ref": "#/$defs/layerRef" },
        "groupBy": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "aggregates": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["count", "area", "length", "sum", "mean", "min", "max", "distinct"] }
        },
        "areaUnit": { "type": "string", "enum": ["m2", "ha", "mu", "km2"], "description": "面积单位必须显式声明——经纬度下算面积无意义" }
      }
    },
    "params.vector.repairGeometry": {
      "type": "object",
      "required": ["target"],
      "additionalProperties": false,
      "properties": {
        "target": { "$ref": "#/$defs/layerRef" },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["self-intersection", "duplicate-vertex", "ring-orientation", "unclosed-ring", "spike", "collapsed-ring"] }
        },
        "snapTolerance": { "type": "number", "minimum": 0, "description": "容差过大会吃掉真实小缝隙，默认 0" }
      }
    },
    "params.vector.renameFields": {
      "type": "object",
      "required": ["target", "mapping"],
      "additionalProperties": false,
      "properties": {
        "target": { "$ref": "#/$defs/layerRef" },
        "mapping": { "type": "object", "description": "旧字段名 → 新字段名" }
      }
    },
    "params.vector.recode": {
      "type": "object",
      "required": ["target", "to"],
      "additionalProperties": false,
      "properties": {
        "target": { "$ref": "#/$defs/layerRef" },
        "from": { "type": "string", "enum": ["GBK", "UTF-8", "LATIN1", "auto"], "default": "auto" },
        "to": { "type": "string", "enum": ["GBK", "UTF-8", "LATIN1"] },
        "writeEncodingMarker": { "type": "boolean", "default": true, "description": "写 .cpg 文件，Shapefile 必须有它否则下次打开又乱码" }
      }
    },
    "params.vector.reproject": {
      "type": "object",
      "required": ["target", "to"],
      "additionalProperties": false,
      "properties": {
        "target": { "$ref": "#/$defs/layerRef" },
        "to": { "type": "string", "description": "目标 CRS，如 EPSG:CGCS2000_3_Degree；写 auto 表示由 alignTo 推导" },
        "output": { "$ref": "#/$defs/layerRef" },
        "alignTo": { "$ref": "#/$defs/layerRef" },
        "resample": { "type": "string", "enum": ["nearest", "bilinear", "cubic"], "default": "bilinear" },
        "maxResidualPx": { "type": "number", "minimum": 0, "description": "转换后允许的最大残差（像素），超出即中止" }
      }
    },
    "params.vector.overlay": {
      "type": "object",
      "required": ["base", "update", "operation"],
      "additionalProperties": false,
      "properties": {
        "base": { "$ref": "#/$defs/layerRef" },
        "update": { "$ref": "#/$defs/layerRef" },
        "operation": { "enum": ["clip-to-base", "difference", "union", "intersection", "snap-to-base"] },
        "preserveAttributes": { "type": "boolean", "default": true }
      }
    },
    "params.vector.query": {
      "type": "object",
      "required": ["target"],
      "additionalProperties": false,
      "properties": {
        "target": { "$ref": "#/$defs/pathRef" },
        "where": { "type": "string", "maxLength": 500, "description": "筛选条件。SQL 子集（POP2020 > 100 AND NAME LIKE '北%'）或中文人话（\"人口大于100并且名字以北开头\"）——人话会自动翻译。" },
        "fields": { "type": "array", "items": { "type": "string" }, "description": "只返回这几个字段；不给就全部" },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100000, "description": "最多返回多少条要素" }
      }
    },
    "params.vector.addField": {
      "type": "object",
      "required": ["target", "name", "expression"],
      "additionalProperties": false,
      "properties": {
        "target": { "$ref": "#/$defs/pathRef" },
        "name": { "type": "string", "maxLength": 63, "description": "新字段名（Shapefile 的字段名限 10 字符，超了会明确报错）" },
        "expression": { "type": "string", "maxLength": 500, "description": "取值表达式。SQL 子集或中文人话，如 \"POP2020 / AREA\"。" },
        "where": { "type": "string", "maxLength": 500, "description": "只对符合条件的要素赋值，其余留空" }
      }
    },
    "params.vector.spatialJoin": {
      "type": "object",
      "required": ["target", "source", "relation"],
      "additionalProperties": false,
      "properties": {
        "target": { "$ref": "#/$defs/pathRef", "description": "被连接的目标图层：汇总值写回这一层" },
        "source": { "$ref": "#/$defs/pathRef", "description": "提供属性与几何的源图层" },
        "relation": { "enum": ["within", "intersects", "contains"], "description": "within = 目标完全落在源内部；intersects = 有交集即可；contains = 源完全落在目标内部（与 within 反向）" },
        "aggregate": { "enum": ["first", "count", "sum", "mean"], "default": "first", "description": "汇总方式。count 给匹配到的源要素条数；sum/mean 只对数值字段生效" },
        "fields": { "type": "array", "items": { "type": "string" }, "description": "参与汇总的源字段；不给就全部数值字段" },
        "fieldPrefix": { "type": "string", "maxLength": 32, "description": "汇总字段名前缀。不给就用源字段名 —— 此时写回目标图层若已存在同名字段会明确报错，不会静默覆盖" }
      }
    },
    "params.export.image": {
      "type": "object",
      "required": ["target", "format"],
      "additionalProperties": false,
      "properties": {
        "target": { "$ref": "#/$defs/layerRef" },
        "bbox": { "$ref": "#/$defs/bbox", "description": "导出范围（EPSG:4326 经纬度）。出图端点只认地理范围，不认像元坐标对象" },
        "format": { "enum": ["png", "jpeg", "pdf", "tif"] },
        "dpi": { "type": "integer", "minimum": 72, "maximum": 1200 },
        "layers": { "type": "array", "items": { "$ref": "#/$defs/layerRef" } }
      }
    },
    "params.export.report": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": ["csv", "change-report", "health-report", "audit-log", "compat-report"],
          "description": "compat-report = 兼容性自检报告（交差用）：文件格式 / 坐标系 / 几何有效性 / 伴随文件 / 在 ArcGIS 中打开需要注意什么 / 本次改动的量化摘要"
        },
        "target": { "$ref": "#/$defs/layerRef" },
        "include": {
          "type": "array",
          "items": {
            "enum": [
              "before-after-image", "op-list", "impact-metrics", "file-hashes", "operator",
              "timestamps", "backups", "crs", "sidecars", "arcgis-notes"
            ]
          }
        },
        "format": { "enum": ["csv", "html", "pdf", "json"], "default": "html" }
      }
    }
  }
}
