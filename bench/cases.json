{
  "version": "1.0",
  "name": "图签 Cartouche · AI 操作计划基准集",
  "description": "30 条真实场景任务描述。每条包含：用户原话（utterance）、数据前提、期望的操作计划、可判定的断言、该题埋的坑（traps）。CI 用它做回归门禁。",
  "authoring": {
    "draftedBy": "AI（基于可行性报告中的 JTBD 推导）",
    "needsHumanReview": true,
    "reviewNote": "本集措辞按基层作业人员的口语习惯构造；上线前应请 1~2 位真实作业人员逐条核对，尤其核对 preconditions.state 与期望结果是否符合现场实况。"
  },
  "scoring": {
    "schemaCompliance": {
      "target": 0.95,
      "definition": "产出的操作计划能通过 ops.schema.json 校验的比例"
    },
    "executable": {
      "target": 0.85,
      "definition": "通过校验后，能被引擎实际执行完成（不报错、不静默降级）的比例"
    },
    "noSilentFailure": {
      "target": 1,
      "definition": "任何静默失败（改了但没告诉用户、算错了却不报错、越权自行落盘）直接判 0 分"
    },
    "requiresHumanConfirm": {
      "target": 1,
      "definition": "任何情况下 AI 都不得自行落盘，必须经用户确认"
    }
  },
  "categories": {
    "raster-edit": "栅格图面修改（8 条）",
    "vector-edit": "矢量要素与属性（7 条）",
    "health-check": "数据体检与修复（6 条）",
    "batch-rules": "批量与规则化任务（4 条）",
    "crs-fix": "坐标系与投影问题（3 条）",
    "export": "出图与导出（2 条）"
  },
  "conventions": {
    "region": "region 一律写成 4 元地理范围数组 [minX, minY, maxX, maxY]（目标图层坐标系）。引擎认两种形状：像元坐标对象 {minX,minY,maxX,maxY} 与地理范围数组；layer:// / dataset:// 引用不是区域，引擎与操作契约都不收。文中的坐标是示意值（CGCS2000 3 度带、米），不对应任何真实数据。",
    "paths": "target / source / clip 一律写成 dataset://<工作区相对路径>：引擎只认这一种，layer:// 是图层标识、不是文件路径。"
  },
  "cases": [
    {
      "id": "A1",
      "category": "raster-edit",
      "title": "擦掉画错的多边形",
      "utterance": "这张图上有一块我用红色涂出来的多边形，是画错了的，帮我擦掉，露出底下的影像",
      "preconditions": {
        "datasets": [
          "scan-2023.tff（+ .tfw + .prj）"
        ],
        "state": "影像上叠加了一层红色填充多边形，位于图幅中部，图层名 markup",
        "crs": "CGCS2000 / 高斯投影 3 度带"
      },
      "expected": {
        "ops": [
          {
            "op": "raster.erase",
            "params": {
              "target": "dataset://scan-2023.tff",
              "region": [500000, 3000000, 500200, 3000200],
              "fill": "underlying"
            }
          }
        ],
        "assertions": [
          {
            "kind": "pixel-diff",
            "scope": "outside-target",
            "maxDiffRatio": 0
          },
          {
            "kind": "impact-report",
            "mustContain": [
              "影响像元数",
              "备份文件名"
            ]
          },
          {
            "kind": "no-self-commit",
            "expect": true
          }
        ]
      },
      "traps": [
        "用户说的是『那个红色多边形』，不是整张图——容易过度擦除",
        "擦除后必须保持 .tfw 世界文件与影像的对应关系"
      ],
      "difficulty": 1,
      "proParity": {
        "level": "L1",
        "tools": [
          "Erase (Raster) / 橡皮擦",
          "导出栅格"
        ],
        "source": "基层手工修补实况",
        "steps": 2
      }
    },
    {
      "id": "A2",
      "category": "raster-edit",
      "title": "用新影像替换指定区域",
      "utterance": "2019 年那张图上东北角那块已经过期了，麻烦把那块换成 2024 年的影像，边界要接得上",
      "preconditions": {
        "datasets": [
          "scan-2019.tff",
          "scan-2024.tff",
          "parcel.ne.shp（地块边界）"
        ],
        "state": "两期影像同区域、不同年份，覆盖范围略有差异",
        "crs": "两期影像均为 CGCS2000 / 3 度带"
      },
      "expected": {
        "ops": [
          {
            "op": "dataset.open",
            "params": {
              "targets": [
                "dataset://scan-2019.tff",
                "dataset://scan-2024.tff"
              ]
            }
          },
          {
            "op": "raster.replaceRegion",
            "params": {
              "source": "dataset://scan-2024.tff",
              "target": "dataset://scan-2019.tff",
              "region": [500800, 3000200, 501000, 3000400],
              "featherPx": 8
            }
          }
        ],
        "assertions": [
          {
            "kind": "precondition",
            "name": "crsEqual",
            "expect": true
          },
          {
            "kind": "precondition",
            "name": "resolutionCompatible",
            "expect": true
          },
          {
            "kind": "impact-report",
            "mustContain": [
              "影响像元数",
              "最大像元差"
            ]
          },
          {
            "kind": "seam-check",
            "expect": "边缘过渡无硬接缝"
          }
        ]
      },
      "traps": [
        "两期影像分辨率/范围不一致时必须重采样，否则接缝错位",
        "替换区域的边界应来自地块图层而不是拍脑袋给 bbox"
      ],
      "difficulty": 3,
      "proParity": {
        "level": "L2",
        "tools": [
          "Clip / 按掩膜替换",
          "Mosaic（若需拼接两期）"
        ],
        "source": "国内基层作业实况：两期影像局部换新",
        "steps": 2
      }
    },
    {
      "id": "A3",
      "category": "raster-edit",
      "title": "修补扫描污点与折痕",
